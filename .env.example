# =====================================================================
# 复制为 .env 后填写。不要把填写后的 .env 提交到 Git。
# 密码建议 24 位以上随机字符串：openssl rand -base64 24
# =====================================================================

# --- 业务数据库（PostgreSQL 容器） ---
POSTGRES_DB=campus
POSTGRES_USER=campus_dba
POSTGRES_PASSWORD=__CHANGE_ME_DBA_PASSWORD__

# --- 应用最小权限账号密码（对应 sql/003_roles.sql 的 app_password） ---
APP_DB_PASSWORD=__CHANGE_ME_APP_PASSWORD__

# --- 只读账号密码（对应 sql/003_roles.sql 的 ro_password）---
# 用途：只读查询与审计核对；scripts/restore.sh 也会读取本项
RO_DB_PASSWORD=__CHANGE_ME_RO_PASSWORD__

# --- Appsmith 加密密钥（初始化后不可更改，否则已存凭据无法解密） ---
APPSMITH_ENCRYPTION_PASSWORD=__CHANGE_ME_APPSMITH_ENCRYPTION_PASSWORD__
APPSMITH_ENCRYPTION_SALT=__CHANGE_ME_APPSMITH_ENCRYPTION_SALT__

# --- 导入限制 ---
MAX_UPLOAD_MB=10
MAX_ROWS=10000
# true 表示保留原始上传文件（仅虚构数据阶段可开）
KEEP_UPLOAD_FILES=false

# ---------------------------------------------------------------------------
# 内部请求认证（默认关闭）
# 关闭时业务接口保持旧行为；开启后要求 Java 网关为每个业务请求生成
# X-Internal-* 签名头。密钥必须与网关一致，至少 32 字符：
#   openssl rand -hex 32
# 修改开关后需重建容器：docker compose up -d --force-recreate import-api
# ---------------------------------------------------------------------------
INTERNAL_AUTH_ENABLED=false
INTERNAL_HMAC_SECRET=
# Sa-Token JWT 签名密钥（≥32 字符）；生产必须由密钥管理提供，禁止写死
JWT_SECRET_KEY=__CHANGE_ME_JWT_SECRET_AT_LEAST_32_CHARS__

# ---------------------------------------------------------------------------
# PR-B 网关（RuoYi 最小切片）
# 认证库独立于业务库；网关账号对 campus schema 零权限。
# ---------------------------------------------------------------------------
GATEWAY_DB_NAME=campus_gateway
GATEWAY_DB_USER=gateway_dba
GATEWAY_DB_PASSWORD=__CHANGE_ME_GATEWAY_DB_PASSWORD__
GATEWAY_REDIS_PASSWORD=__CHANGE_ME_GATEWAY_REDIS_PASSWORD__
