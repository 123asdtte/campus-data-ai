# 前端镜像：多阶段构建——容器内完成 npm 安装与构建，宿主机无需 Node。
#
# 历史背景：Docker Desktop 会在 ~/.docker/config.json 注入代理（127.0.0.1:8080），
# 该代理对构建容器不可用（容器内 127.0.0.1 指向自身），导致 npm 安装失败。
# 因此构建阶段的 npm 显式使用直连与官方源；宿主机只需装 Docker。

# ---------- 阶段 1：构建 ----------
FROM node:22-alpine AS build

WORKDIR /build

# 明确使用官方源，绕开被注入的失效代理
ENV npm_config_registry=https://registry.npmjs.org

# 先装依赖（利用层缓存：package.json 不变时跳过）
COPY package.json package-lock.json ./
RUN env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy \
    npm ci --no-audit --no-fund

# 再构建（tsc --noEmit && vite build → dist/）
COPY . .
RUN env -u HTTP_PROXY -u HTTPS_PROXY -u http_proxy -u https_proxy \
    npm run build

# ---------- 阶段 2：运行 ----------
FROM nginx:1.29-alpine

# 站点配置（含 /api 反向代理与 SPA 回退）
COPY nginx.conf /etc/nginx/conf.d/default.conf

# 构建产物
COPY --from=build /build/dist /usr/share/nginx/html

EXPOSE 80

HEALTHCHECK --interval=15s --timeout=3s --retries=3 \
  CMD curl -fsS --noproxy '*' http://127.0.0.1/healthz || exit 1
