# 环境与凭据（绝不入库）
.env
*.env
!.env.example

# 数据与备份（可能含个人信息，禁止入库）
data/
backups/
uploads/
*.sql.gz
*.dump

# 演示异动台账运行时状态（由 demo-api 写入）
demo-api/state/

# 生产运行时配置（由 scripts/render-gateway-config.py 生成）
runtime-config/

# Python
__pycache__/
*.py[cod]
.venv/
.venv*/
.pytest_cache/
.ruff_cache/

# 前端
web/node_modules/
web/dist/
web/.vite/
web/*.local

# 离线依赖：体积约 45MB，按 scripts/fetch-wheels.sh 重建
import-api/wheels/*.whl
!import-api/wheels/.gitkeep

# 临时与系统
.tmp/
*.log
*.pid
*.bak
Thumbs.db
.DS_Store

# 私钥与证书（严禁入库）
certs/
*.pem
*.key
*.p12
*.pfx
id_rsa*
id_ed25519*

# 测试与覆盖率产物
coverage/
htmlcov/
*.lcov
.playwright/

# 样例文件可提交（全部为虚构数据），排除 Office 临时文件
samples/~$*
samples/*.tmp
