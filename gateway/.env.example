# PR-B 网关运行环境变量模板
# 复制为本地 .env 或由 docker compose 注入；真实值不得提交到 Git。
# 生成随机值：openssl rand -base64 24 / openssl rand -hex 32

# 网关认证库（独立于业务库 campus）
GATEWAY_DB_NAME=campus_gateway
GATEWAY_DB_USER=gateway_dba
GATEWAY_DB_PASSWORD=__CHANGE_ME_GATEWAY_DB_PASSWORD__

# 网关会话缓存 Redis
GATEWAY_REDIS_PASSWORD=__CHANGE_ME_GATEWAY_REDIS_PASSWORD__

# 网关与 FastAPI 共享的 HMAC 密钥（至少 32 字符）
INTERNAL_HMAC_SECRET=__CHANGE_ME_INTERNAL_HMAC_SECRET__

# 业务服务地址（容器内按服务名访问）
INTERNAL_IMPORTAPI_BASE=http://import-api:8000
